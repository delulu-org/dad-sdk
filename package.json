{
  "name": "@delulu-addons/dad-sdk",
  "version": "1.1.0",
  "description": "Delulu Addon Development (DAD) SDK - build, test, and ship HTTP addons for Delulu",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "dad": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "delulu",
    "dad-sdk",
    "streaming",
    "addons",
    "stremio-alternative",
    "cli"
  ],
  "author": "Delulu Core Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delulu-org/dad-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/delulu-org/dad-sdk/issues"
  },
  "homepage": "https://github.com/delulu-org/dad-sdk#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
